# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mcp_tools

# Connection Pool Settings
MAX_OPEN_CONNECTIONS=32
WARMUP_LIMIT=5

# Rate Limiting
GLOBAL_RATE=10.0
GLOBAL_CAPACITY=20
PER_SERVER_RATE=2.0
PER_SERVER_CAPACITY=5

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30.0
CB_HALF_OPEN_SUCCESS=2

# Processing Device (cuda or cpu)
DEVICE=cpu

# Quantization
QUANTIZE_EMBEDDER=1
QUANTIZE_TIMEOUT=30
